}


// =============================================================
//  computeHmac — internal utility
//  Returns a hex string: HMAC-SHA256(userId, HMAC_SECRET)
// =============================================================
function computeHmac(userId) {
  var rawBytes = Utilities.computeHmacSha256Signature(
    userId,
    HMAC_SECRET,
    Utilities.Charset.UTF_8
  );
  // Convert byte array to hex string
  return rawBytes.map(function(b) {
    return ('0' + (b & 0xff).toString(16)).slice(-2);
  }).join('');
}
